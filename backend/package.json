{
  "name": "@cloudfleet/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "CloudFleet Serverless Backend & S3 Storage Layer",
  "main": "dist/handlers/api.js",
  "scripts": {
    "build": "tsc && node -e \"fs.writeFileSync('dist/package.json', JSON.stringify({type:'module'}))\"",
    "dev": "tsx watch src/localServer.ts",
    "start": "node dist/localServer.js",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}